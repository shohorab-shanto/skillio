{
	"info": {
		"_postman_id": "skillo-api-collection",
		"name": "Skillo Mobile API",
		"description": "Complete API collection for Skillo mobile application including authentication and user onboarding",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\",\n  \"password_confirmation\": \"Password123\",\n  \"role\": \"user\",\n  \"gdpr_consent\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"register"
							]
						},
						"description": "Register a new user account. Only users can register through API, mentors cannot self-register."
					},
					"response": []
				},
				{
					"name": "Login User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\",\n  \"remember\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Authenticate user and return access token. Both users and mentors can login."
					},
					"response": []
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"me"
							]
						},
						"description": "Get current authenticated user information"
					},
					"response": []
				},
				{
					"name": "Logout User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"logout"
							]
						},
						"description": "Logout user and invalidate token"
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/refresh",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"refresh"
							]
						},
						"description": "Refresh authentication token"
					},
					"response": []
				},
				{
					"name": "Forgot Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/forgot-password",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"forgot-password"
							]
						},
						"description": "Send password reset link to user email"
					},
					"response": []
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"reset_token_here\",\n  \"email\": \"john@example.com\",\n  \"password\": \"NewPassword123\",\n  \"password_confirmation\": \"NewPassword123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/reset-password",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"reset-password"
							]
						},
						"description": "Reset user password using token from email"
					},
					"response": []
				}
			],
			"description": "Authentication endpoints for user registration, login, logout, and password management"
		},
		{
			"name": "Onboarding - Public",
			"item": [
				{
					"name": "Get Categories",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/onboarding/categories",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"onboarding",
								"categories"
							]
						},
						"description": "Get all available categories with their subcategories. Shows which subcategories are custom and who created them."
					},
					"response": []
				},
				{
					"name": "Get Countries",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/onboarding/countries",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"onboarding",
								"countries"
							]
						},
						"description": "Get list of available countries for location selection"
					},
					"response": []
				}
			],
			"description": "Public onboarding endpoints that don't require authentication"
		},
		{
			"name": "Onboarding - Protected",
			"item": [
				{
					"name": "Save Category Selection",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"category_id\": 6,\n  \"sub_category_id\": 2,\n  \"custom_category_name\": \"My Custom Skill\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/onboarding/category-selection",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"onboarding",
								"category-selection"
							]
						},
						"description": "Save user's category and subcategory selection. If 'Others' category is selected with custom_category_name, creates a new custom subcategory."
					},
					"response": []
				},
				{
					"name": "Save Education Type",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"education_type\": \"in-person\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/onboarding/education-type",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"onboarding",
								"education-type"
							]
						},
						"description": "Save user's education type preference (in-person or online)"
					},
					"response": []
				},
				{
					"name": "Save Location (In-Person)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"country\": \"United States\",\n  \"city\": \"New York\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/onboarding/location",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"onboarding",
								"location"
							]
						},
						"description": "Save user's location preference for in-person education"
					},
					"response": []
				},
				{
					"name": "Save Online Options",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"education_option\": \"both\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/onboarding/online-options",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"onboarding",
								"online-options"
							]
						},
						"description": "Save user's online education preferences (courses, mentoring, or both)"
					},
					"response": []
				},
				{
					"name": "Get Onboarding Status",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/onboarding/status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"onboarding",
								"status"
							]
						},
						"description": "Get current onboarding progress and next step"
					},
					"response": []
				},
				{
					"name": "Get User Preferences",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/onboarding/preferences",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"onboarding",
								"preferences"
							]
						},
						"description": "Get user's saved preferences including category, education type, location, etc."
					},
					"response": []
				},
				{
					"name": "Get My Custom Subcategories",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/onboarding/my-custom-subcategories",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"onboarding",
								"my-custom-subcategories"
							]
						},
						"description": "Get all custom subcategories created by the current user"
					},
					"response": []
				}
			],
			"description": "Protected onboarding endpoints that require authentication"
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"description": "Base URL for the Skillo API"
		},
		{
			"key": "auth_token",
			"value": "",
			"description": "Authentication token obtained from login"
		}
	]
}
